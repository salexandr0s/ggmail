msgid "(no subject)"
msgstr "(sin asunto)"

#. conflictName and extensionName are extensions' names. “it” is extensionName, the extension being turned on: turning it on again retries the swap, since conflictName is already off
#: packages/app/lib/extension-swap.ts
msgid "{conflictName} is off, but some of its files may be left in ggmail. {extensionName} wasn't installed. Turn it on to try again."
msgstr "{conflictName} está desactivada, pero es posible que queden algunos de sus archivos en ggmail. No se instaló {extensionName}. Activa {extensionName} para volver a intentarlo."

#: packages/app/lib/extension-swap.ts
msgid "{conflictName} is still on, and {extensionName} wasn't installed."
msgstr "{conflictName} sigue activada y no se instaló {extensionName}."

#: packages/app/lib/extension-swap.ts
msgid "{conflictName} was turned off, and you're signed out of it in ggmail."
msgstr "Se desactivó {conflictName} y se cerró tu sesión de esa extensión en ggmail."

