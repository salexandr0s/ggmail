msgstr "{large} ή περισσότερο"

#. name is the name of a browser extension, such as Bitwarden
#: packages/app/lib/extension-window.ts
msgid "{name} is running, but ggmail can't open a window for it."
msgstr "Η επέκταση {name} εκτελείται, αλλά το ggmail δεν μπορεί να ανοίξει παράθυρο για αυτή."

#. name is the name of a browser extension, such as Bitwarden
#: packages/app/lib/extension-swap.ts
msgid "{name} is still on."
msgstr "Η επέκταση {name} παραμένει ενεργή."

#. name is an extension's name
#: packages/renderer/routes/settings/extensions.tsx
msgid "{name} is up to date"
msgstr "Η έκδοση του {name} είναι ενημερωμένη"

#. name is the name of a browser extension, such as Bitwarden
#: packages/app/lib/extension-window.ts
msgid "{name} starts after ggmail restarts. Restart ggmail, then try again."
msgstr "Η επέκταση {name} ξεκινά μετά την επανεκκίνηση του ggmail. Επανεκκινήστε το ggmail και δοκιμάστε ξανά."

#. name is an extension's name
#: packages/renderer/routes/settings/extensions.tsx
msgid "{name} updated to {version}"
msgstr "Το {name} ενημερώθηκε στην έκδοση {version}"

#. name is an extension's name; reason is the technical reason, left untranslated
#: packages/renderer/routes/settings/extensions.tsx
msgid "{name}: {reason}"
msgstr "{name}: {reason}"

#. The first form is shown on Windows, the other on macOS
#: packages/app/workspace-app.ts
msgid "{platformName, select, windows {Continue with Windows Hello if you've created a passkey in ggmail. Passkeys from Chrome, Google Password Manager, or your phone don't work here — sign in with your password or another second factor, then create a passkey for ggmail in your Google account's security settings.} other {Continue with Touch ID if you've created a passkey in ggmail. Passkeys from Chrome, iCloud, or your phone don't work here — sign in with your password or another second factor, then create a passkey for ggmail in your Google account's security settings.}}"
msgstr "{platformName, select, windows {Συνεχίστε με το Windows Hello αν έχετε δημιουργήσει κλειδί πρόσβασης στο ggmail. Τα κλειδιά από το Chrome, τη Διαχείριση κωδικών πρόσβασης Google ή το τηλέφωνό σας δεν λειτουργούν εδώ. Συνδεθείτε με τον κωδικό σας ή με άλλον δεύτερο παράγοντα και δημιουργήστε κλειδί για το ggmail στις ρυθμίσεις ασφαλείας του λογαριασμού σας Google.} other {Συνεχίστε με το Touch ID αν έχετε δημιουργήσει κλειδί πρόσβασης στο ggmail. Τα κλειδιά από το Chrome, το iCloud ή το τηλέφωνό σας δεν λειτουργούν εδώ. Συνδεθείτε με τον κωδικό σας ή με άλλον δεύτερο παράγοντα και δημιουργήστε κλειδί για το ggmail στις ρυθμίσεις ασφαλείας του λογαριασμού σας Google.}}"

#. The Excluded apps field once more than three apps are excluded: the names of the first three, then how many more are excluded
#: packages/renderer/routes/settings/workspace-apps.tsx
msgid "{remainingExcludedAppCount, plural, one {{visibleExcludedApps} +# excluded} other {{visibleExcludedApps} +# excluded}}"
msgstr "{remainingExcludedAppCount, plural, one {{visibleExcludedApps} και # ακόμη εξαίρεση} other {{visibleExcludedApps} και # ακόμη εξαιρέσεις}}"

#. Spellchecker languages chosen beyond the system language, counted once there are more than two to name
#: packages/renderer/routes/settings/languages.tsx
msgid "{selectedCount, plural, one {# additional language} other {# additional languages}}"
msgstr "{selectedCount, plural, one {# επιπλέον γλώσσα} other {# επιπλέον γλώσσες}}"

#: packages/renderer/components/attachments/detail-filters.tsx
msgid "{small} to under {large}"
msgstr "Από {small} έως κάτω από {large}"

#. Tooltip of the tab every link to a Google Workspace app opens in. tabTitle is the page's title; appName is the app's English name, such as Calendar
#: packages/renderer/components/vertical-tabs.tsx
msgid "{tabTitle} — opens {appName} links"
msgstr "{tabTitle} — ανοίγει συνδέσμους {appName}"

#. appLinksTabTitle is the title of the tab that opens the links today; appLabel is the name of a Google Workspace app, such as Docs or Sheets
#: packages/app/dialogs.ts
msgid "{target, select, window {“{appLinksTabTitle}” currently opens all {appLabel} links. This window will open them instead.} other {“{appLinksTabTitle}” currently opens all {appLabel} links. This tab will open them instead.}}"
msgstr "{target, select, window {Οι σύνδεσμοι {appLabel} ανοίγουν στην καρτέλα «{appLinksTabTitle}». Στο εξής θα ανοίγουν σε αυτό το παράθυρο.} other {Οι σύνδεσμοι {appLabel} ανοίγουν στην καρτέλα «{appLinksTabTitle}». Στο εξής θα ανοίγουν σε αυτή την καρτέλα.}}"

#. Tab context menu item; appLabel is the name of a Google Workspace app, such as Docs or Sheets
#: packages/app/ipc.ts
msgid "{target, select, window {New {appLabel} Window} other {New {appLabel} Tab}}"
msgstr "{target, select, window {Νέο παράθυρο {appLabel}} other {Νέα καρτέλα {appLabel}}}"

#. appLabel is the name of a Google Workspace app, such as Docs or Sheets
#: packages/app/dialogs.ts
msgid "{target, select, window {Open {appLabel} links in this window?} other {Open {appLabel} links in this tab?}}"
msgstr "{target, select, window {Άνοιγμα συνδέσμων {appLabel} σε αυτό το παράθυρο;} other {Άνοιγμα συνδέσμων {appLabel} σε αυτή την καρτέλα;}}"

#. Tab context menu checkbox that makes this tab open the app's links; appLabel is the name of a Google Workspace app, such as Docs or Sheets
#: packages/app/ipc.ts
msgid "{target, select, window {Open {appLabel} Links in This Window} other {Open {appLabel} Links in This Tab}}"
msgstr "{target, select, window {Άνοιγμα συνδέσμων {appLabel} σε αυτό το παράθυρο} other {Άνοιγμα συνδέσμων {appLabel} σε αυτή την καρτέλα}}"

#. Dialog asking to confirm switching the Workspace apps Mode setting to New windows, which says more when Workspace app tabs are open, when pinned apps load on launch, or both
#: packages/renderer/routes/settings/workspace-apps.tsx
msgid "{workspaceAppsInUse, select, both {Workspace apps open in their own window from now on. The tabs you already have open stay as they are, and the tab strip hides after you close them, or after a restart. Pinned apps set to load on launch open as windows the next time you start ggmail.} openTabs {Workspace apps open in their own window from now on. The tabs you already have open stay as they are, and the tab strip hides after you close them, or after a restart.} loadOnLaunch {Workspace apps open in their own window from now on. Pinned apps set to load on launch open as windows the next time you start ggmail.} other {Workspace apps open in their own window from now on.}}"
msgstr "{workspaceAppsInUse, select, both {Οι εφαρμογές Workspace θα ανοίγουν σε δικά τους παράθυρα. Οι ανοιχτές καρτέλες παραμένουν ως έχουν. Η γραμμή καρτελών θα κρυφτεί όταν τις κλείσετε ή μετά από επανεκκίνηση. Οι καρφιτσωμένες εφαρμογές με αυτόματη φόρτωση θα ανοίξουν σε παράθυρα την επόμενη φορά που θα ξεκινήσει το ggmail.} openTabs {Οι εφαρμογές Workspace θα ανοίγουν σε δικά τους παράθυρα. Οι ανοιχτές καρτέλες παραμένουν ως έχουν. Η γραμμή καρτελών θα κρυφτεί όταν τις κλείσετε ή μετά από επανεκκίνηση.} loadOnLaunch {Οι εφαρμογές Workspace θα ανοίγουν σε δικά τους παράθυρα. Οι καρφιτσωμένες εφαρμογές με αυτόματη φόρτωση θα ανοίξουν σε παράθυρα την επόμενη φορά που θα ξεκινήσει το ggmail.} other {Οι εφαρμογές Workspace θα ανοίγουν σε δικά τους παράθυρα.}}"

