msgstr "Ο λογαριασμός {label} συγχρονίζεται ακόμη"

#: packages/renderer/routes/unified-inbox.tsx
msgid "{label} is up to date"
msgstr "Ο λογαριασμός {label} είναι ενημερωμένος"

