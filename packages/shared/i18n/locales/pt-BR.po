#. conflictName and extensionName are extensions' names. “it” is extensionName, the extension being turned on: turning it on again retries the swap, since conflictName is already off
#: packages/app/lib/extension-swap.ts
msgid "{conflictName} is off, but some of its files may be left in ggmail. {extensionName} wasn't installed. Turn it on to try again."
msgstr "A extensão {conflictName} está desativada, mas alguns arquivos dela podem ter ficado no ggmail. A extensão {extensionName} não foi instalada. Ative-a para tentar novamente."

#: packages/app/lib/extension-swap.ts
msgid "{conflictName} is still on, and {extensionName} wasn't installed."
msgstr "A extensão {conflictName} continua ativada, e a extensão {extensionName} não foi instalada."

#: packages/app/lib/extension-swap.ts
msgid "{conflictName} was turned off, and you're signed out of it in ggmail."
msgstr "A extensão {conflictName} foi desativada, e você saiu da conta dela no ggmail."

#: packages/renderer/components/attachments/filters.tsx
#: packages/renderer/routes/attachments.tsx
msgid "{count, plural, one {# file} other {# files}}"
msgstr "{count, plural, one {# arquivo} many {# arquivos} other {# arquivos}}"

#. On Linux, a finished download's notification acts when clicked; elsewhere, through its button
#: packages/renderer/routes/settings/notifications.tsx
msgid "{downloadNotificationAction, select, click {Choose what clicking the notification does.} other {Choose what the notification's button does.}}"
msgstr "{downloadNotificationAction, select, click {Escolher o que acontece ao clicar na notificação.} other {Escolher o que o botão da notificação faz.}}"

#. Setting that picks what a finished download's notification does: on Linux, clicking it; elsewhere, its button
#: packages/renderer/routes/settings/notifications.tsx
msgid "{downloadNotificationAction, select, click {On click} other {Button}}"
msgstr "{downloadNotificationAction, select, click {Ao clicar} other {Botão}}"

#. Placeholder of the Color field, giving two example colors: a hex code and an rgb() value
#: packages/renderer/routes/settings/gmail/label-colors.tsx
msgid "{EXAMPLE_HEX_COLOR} or {EXAMPLE_RGB_COLOR}"
msgstr "{EXAMPLE_HEX_COLOR} ou {EXAMPLE_RGB_COLOR}"

#. extensionName is a password manager extension's name
#: packages/renderer/routes/settings/extensions.tsx
msgid "{extensionName} runs on Google's sign-in pages only. Add a site to run it there too, such as your company's single sign-on provider. Sites apply after a restart."
msgstr "A extensão {extensionName} é executada somente nas páginas de login do Google. Adicione um site para executá-la nele também, como o provedor de login único da sua empresa. Os sites são aplicados depois de reiniciar."

#. Title of the dialog when more than one extension failed to update
#: packages/renderer/routes/settings/extensions.tsx
msgid "{failedCount, plural, one {Couldn't update # extension} other {Couldn't update # extensions}}"
msgstr "{failedCount, plural, one {Não foi possível atualizar # extensão} many {Não foi possível atualizar # extensões} other {Não foi possível atualizar # extensões}}"

#: packages/renderer/components/inbox-accounts.tsx
msgid "{label} is still syncing"
msgstr "{label} ainda está sincronizando"

#: packages/renderer/components/inbox-accounts.tsx
msgid "{label} is up to date"
msgstr "{label} está em dia"

#: packages/renderer/components/inbox-accounts.tsx
msgid "{label} will retry syncing"
msgstr "A sincronização de {label} será tentada novamente"

#: packages/renderer/components/attachments/detail-filters.tsx
msgid "{large} or more"
msgstr "{large} ou mais"

#. name is the name of a browser extension, such as Bitwarden
#: packages/app/lib/extension-window.ts
msgid "{name} is running, but ggmail can't open a window for it."
msgstr "A extensão {name} está em execução, mas o ggmail não consegue abrir uma janela para ela."

#. name is the name of a browser extension, such as Bitwarden
#: packages/app/lib/extension-swap.ts
msgid "{name} is still on."
msgstr "A extensão {name} continua ativada."

#. name is an extension's name
#: packages/renderer/routes/settings/extensions.tsx
msgid "{name} is up to date"
msgstr "A extensão {name} está atualizada"

#. name is the name of a browser extension, such as Bitwarden
#: packages/app/lib/extension-window.ts
msgid "{name} starts after ggmail restarts. Restart ggmail, then try again."
msgstr "A extensão {name} é iniciada quando o ggmail reinicia. Reinicie o ggmail e tente novamente."

#. name is an extension's name
#: packages/renderer/routes/settings/extensions.tsx
msgid "{name} updated to {version}"
msgstr "A extensão {name} foi atualizada para {version}"

#. name is an extension's name; reason is the technical reason, left untranslated
#: packages/renderer/routes/settings/extensions.tsx
msgid "{name}: {reason}"
msgstr "{name}: {reason}"

#. The first form is shown on Windows, the other on macOS
#: packages/app/workspace-app.ts
msgid "{platformName, select, windows {Continue with Windows Hello if you've created a passkey in ggmail. Passkeys from Chrome, Google Password Manager, or your phone don't work here — sign in with your password or another second factor, then create a passkey for ggmail in your Google account's security settings.} other {Continue with Touch ID if you've created a passkey in ggmail. Passkeys from Chrome, iCloud, or your phone don't work here — sign in with your password or another second factor, then create a passkey for ggmail in your Google account's security settings.}}"
msgstr "{platformName, select, windows {Continue com o Windows Hello se você criou uma chave de acesso no ggmail. Chaves de acesso do Chrome, do Gerenciador de senhas do Google ou do seu celular não funcionam aqui — faça login com sua senha ou outro segundo fator e depois crie uma chave de acesso para o ggmail nas configurações de segurança da sua Conta do Google.} other {Continue com o Touch ID se você criou uma chave de acesso no ggmail. Chaves de acesso do Chrome, do iCloud ou do seu celular não funcionam aqui — faça login com sua senha ou outro segundo fator e depois crie uma chave de acesso para o ggmail nas configurações de segurança da sua Conta do Google.}}"

#. The Excluded apps field once more than three apps are excluded: the names of the first three, then how many more are excluded
#: packages/renderer/routes/settings/workspace-apps.tsx
msgid "{remainingExcludedAppCount, plural, one {{visibleExcludedApps} +# excluded} other {{visibleExcludedApps} +# excluded}}"
msgstr "{remainingExcludedAppCount, plural, one {{visibleExcludedApps} +# excluído} many {{visibleExcludedApps} +# excluídos} other {{visibleExcludedApps} +# excluídos}}"

#. Spellchecker languages chosen beyond the system language, counted once there are more than two to name
#: packages/renderer/routes/settings/languages.tsx
msgid "{selectedCount, plural, one {# additional language} other {# additional languages}}"
msgstr "{selectedCount, plural, one {# idioma adicional} many {# idiomas adicionais} other {# idiomas adicionais}}"

#: packages/renderer/components/attachments/detail-filters.tsx
msgid "{small} to under {large}"
msgstr "De {small} a menos de {large}"

#. Tooltip of the tab every link to a Google Workspace app opens in. tabTitle is the page's title; appName is the app's English name, such as Calendar
#: packages/renderer/components/workspace-tabs.tsx
msgid "{tabTitle} — opens {appName} links"
msgstr "{tabTitle} — abre os links do {appName}"

#. appLinksTabTitle is the title of the tab that opens the links today; appLabel is the name of a Google Workspace app, such as Docs or Sheets
#: packages/app/dialogs.ts
msgid "{target, select, window {“{appLinksTabTitle}” currently opens all {appLabel} links. This window will open them instead.} other {“{appLinksTabTitle}” currently opens all {appLabel} links. This tab will open them instead.}}"
msgstr "{target, select, window {No momento, “{appLinksTabTitle}” abre todos os links do {appLabel}. Esta janela passará a abri-los.} other {No momento, “{appLinksTabTitle}” abre todos os links do {appLabel}. Esta guia passará a abri-los.}}"

#. Tab context menu item; appLabel is the name of a Google Workspace app, such as Docs or Sheets
#: packages/app/ipc.ts
msgid "{target, select, window {New {appLabel} Window} other {New {appLabel} Tab}}"
msgstr "{target, select, window {Nova Janela do {appLabel}} other {Nova Guia do {appLabel}}}"

#. appLabel is the name of a Google Workspace app, such as Docs or Sheets
#: packages/app/dialogs.ts
msgid "{target, select, window {Open {appLabel} links in this window?} other {Open {appLabel} links in this tab?}}"
msgstr "{target, select, window {Abrir os links do {appLabel} nesta janela?} other {Abrir os links do {appLabel} nesta guia?}}"

#. Tab context menu checkbox that makes this tab open the app's links; appLabel is the name of a Google Workspace app, such as Docs or Sheets
#: packages/app/ipc.ts
msgid "{target, select, window {Open {appLabel} Links in This Window} other {Open {appLabel} Links in This Tab}}"
msgstr "{target, select, window {Abrir Links do {appLabel} Nesta Janela} other {Abrir Links do {appLabel} Nesta Guia}}"

#. Dialog asking to confirm switching the Workspace apps Mode setting to New windows, which says more when Workspace app tabs are open, when pinned apps load on launch, or both
#: packages/renderer/routes/settings/workspace-apps.tsx
msgid "{workspaceAppsInUse, select, both {Workspace apps open in their own window from now on. The tabs you already have open stay as they are, and the tab strip hides after you close them, or after a restart. Pinned apps set to load on launch open as windows the next time you start ggmail.} openTabs {Workspace apps open in their own window from now on. The tabs you already have open stay as they are, and the tab strip hides after you close them, or after a restart.} loadOnLaunch {Workspace apps open in their own window from now on. Pinned apps set to load on launch open as windows the next time you start ggmail.} other {Workspace apps open in their own window from now on.}}"
msgstr "{workspaceAppsInUse, select, both {A partir de agora, os apps do Workspace abrem em uma janela própria. As guias que você já tem abertas continuam como estão, e a barra de guias é ocultada depois que você as fechar ou depois de reiniciar. Os apps fixados configurados para carregar ao iniciar abrem como janelas na próxima vez que você iniciar o ggmail.} openTabs {A partir de agora, os apps do Workspace abrem em uma janela própria. As guias que você já tem abertas continuam como estão, e a barra de guias é ocultada depois que você as fechar ou depois de reiniciar.} loadOnLaunch {A partir de agora, os apps do Workspace abrem em uma janela própria. Os apps fixados configurados para carregar ao iniciar abrem como janelas na próxima vez que você iniciar o ggmail.} other {A partir de agora, os apps do Workspace abrem em uma janela própria.}}"

