msgstr "{EXAMPLE_HEX_COLOR} lub {EXAMPLE_RGB_COLOR}"

#. extensionName is a password manager extension's name
#: packages/renderer/routes/settings/extensions.tsx
msgid "{extensionName} runs on Google's sign-in pages only. Add a site to run it there too, such as your company's single sign-on provider. Sites apply after a restart."
msgstr "Rozszerzenie {extensionName} działa tylko na stronach logowania Google. Dodaj witrynę, aby działało także na niej, np. witrynę dostawcy logowania jednokrotnego Twojej firmy. Zmiany witryn zostaną zastosowane po ponownym uruchomieniu."

#. Title of the dialog when more than one extension failed to update
#: packages/renderer/routes/settings/extensions.tsx
msgid "{failedCount, plural, one {Couldn't update # extension} other {Couldn't update # extensions}}"
msgstr "{failedCount, plural, one {Nie można zaktualizować # rozszerzenia} few {Nie można zaktualizować # rozszerzeń} many {Nie można zaktualizować # rozszerzeń} other {Nie można zaktualizować # rozszerzenia}}"

