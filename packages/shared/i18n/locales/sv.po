msgstr "{selectedCount, plural, one {# ytterligare språk} other {# ytterligare språk}}"

#: packages/renderer/components/attachments/detail-filters.tsx
msgid "{small} to under {large}"
msgstr "Från {small} till under {large}"

#. Tooltip of the tab every link to a Google Workspace app opens in. tabTitle is the page's title; appName is the app's English name, such as Calendar
#: packages/renderer/components/workspace-tabs.tsx
msgid "{tabTitle} — opens {appName} links"
msgstr "{tabTitle} – öppnar länkar till {appName}"

#. appLinksTabTitle is the title of the tab that opens the links today; appLabel is the name of a Google Workspace app, such as Docs or Sheets
#: packages/app/dialogs.ts
msgid "{target, select, window {“{appLinksTabTitle}” currently opens all {appLabel} links. This window will open them instead.} other {“{appLinksTabTitle}” currently opens all {appLabel} links. This tab will open them instead.}}"
msgstr "{target, select, window {”{appLinksTabTitle}” öppnar för närvarande alla länkar till {appLabel}. Det här fönstret öppnar dem i stället.} other {”{appLinksTabTitle}” öppnar för närvarande alla länkar till {appLabel}. Den här fliken öppnar dem i stället.}}"

#. Tab context menu item; appLabel is the name of a Google Workspace app, such as Docs or Sheets
#: packages/app/ipc.ts
msgid "{target, select, window {New {appLabel} Window} other {New {appLabel} Tab}}"
msgstr "{target, select, window {Nytt fönster för {appLabel}} other {Ny flik för {appLabel}}}"

#. appLabel is the name of a Google Workspace app, such as Docs or Sheets
#: packages/app/dialogs.ts
msgid "{target, select, window {Open {appLabel} links in this window?} other {Open {appLabel} links in this tab?}}"
msgstr "{target, select, window {Vill du öppna länkar till {appLabel} i det här fönstret?} other {Vill du öppna länkar till {appLabel} i den här fliken?}}"

#. Tab context menu checkbox that makes this tab open the app's links; appLabel is the name of a Google Workspace app, such as Docs or Sheets
#: packages/app/ipc.ts
msgid "{target, select, window {Open {appLabel} Links in This Window} other {Open {appLabel} Links in This Tab}}"
msgstr "{target, select, window {Öppna länkar till {appLabel} i det här fönstret} other {Öppna länkar till {appLabel} i den här fliken}}"

#. Dialog asking to confirm switching the Workspace apps Mode setting to New windows, which says more when Workspace app tabs are open, when pinned apps load on launch, or both
#: packages/renderer/routes/settings/workspace-apps.tsx
msgid "{workspaceAppsInUse, select, both {Workspace apps open in their own window from now on. The tabs you already have open stay as they are, and the tab strip hides after you close them, or after a restart. Pinned apps set to load on launch open as windows the next time you start ggmail.} openTabs {Workspace apps open in their own window from now on. The tabs you already have open stay as they are, and the tab strip hides after you close them, or after a restart.} loadOnLaunch {Workspace apps open in their own window from now on. Pinned apps set to load on launch open as windows the next time you start ggmail.} other {Workspace apps open in their own window from now on.}}"
msgstr "{workspaceAppsInUse, select, both {Workspace-appar öppnas i egna fönster från och med nu. Flikarna du redan har öppna förblir som de är, och flikhuvudet döljs när du har stängt dem eller efter en omstart. Fästa appar som är inställda på att läsas in vid start öppnas som fönster nästa gång du startar ggmail.} openTabs {Workspace-appar öppnas i egna fönster från och med nu. Flikarna du redan har öppna förblir som de är, och flikhuvudet döljs när du har stängt dem eller efter en omstart.} loadOnLaunch {Workspace-appar öppnas i egna fönster från och med nu. Fästa appar som är inställda på att läsas in vid start öppnas som fönster nästa gång du startar ggmail.} other {Workspace-appar öppnas i egna fönster från och med nu.}}"

