msgstr "{EXAMPLE_HEX_COLOR} ou {EXAMPLE_RGB_COLOR}"

#. extensionName is a password manager extension's name
#: packages/renderer/routes/settings/extensions.tsx
msgid "{extensionName} runs on Google's sign-in pages only. Add a site to run it there too, such as your company's single sign-on provider. Sites apply after a restart."
msgstr "{extensionName} ne s’exécute que sur les pages de connexion de Google. Ajoutez un site pour l’y exécuter aussi, comme le fournisseur d’authentification unique de votre entreprise. Les sites ajoutés sont pris en compte après un redémarrage."

#. Title of the dialog when more than one extension failed to update
#: packages/renderer/routes/settings/extensions.tsx
msgid "{failedCount, plural, one {Couldn't update # extension} other {Couldn't update # extensions}}"
msgstr "{failedCount, plural, one {Impossible de mettre à jour # extension} many {Impossible de mettre à jour # extensions} other {Impossible de mettre à jour # extensions}}"

