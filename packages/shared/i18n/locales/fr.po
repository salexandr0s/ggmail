#: packages/renderer/routes/settings/extensions.tsx
msgid "{name} updated to {version}"
msgstr "{name} mis à jour vers la version {version}"

#. name is an extension's name; reason is the technical reason, left untranslated
#: packages/renderer/routes/settings/extensions.tsx
msgid "{name}: {reason}"
msgstr "{name} : {reason}"

#. The first form is shown on Windows, the other on macOS
#: packages/app/workspace-app.ts
msgid "{platformName, select, windows {Continue with Windows Hello if you've created a passkey in ggmail. Passkeys from Chrome, Google Password Manager, or your phone don't work here — sign in with your password or another second factor, then create a passkey for ggmail in your Google account's security settings.} other {Continue with Touch ID if you've created a passkey in ggmail. Passkeys from Chrome, iCloud, or your phone don't work here — sign in with your password or another second factor, then create a passkey for ggmail in your Google account's security settings.}}"
msgstr "{platformName, select, windows {Continuez avec Windows Hello si vous avez créé une clé d’accès dans ggmail. Les clés d’accès de Chrome, du Gestionnaire de mots de passe de Google ou de votre téléphone ne fonctionnent pas ici : connectez-vous avec votre mot de passe ou un autre second facteur, puis créez une clé d’accès pour ggmail dans les paramètres de sécurité de votre compte Google.} other {Continuez avec Touch ID si vous avez créé une clé d’accès dans ggmail. Les clés d’accès de Chrome, d’iCloud ou de votre téléphone ne fonctionnent pas ici : connectez-vous avec votre mot de passe ou un autre second facteur, puis créez une clé d’accès pour ggmail dans les paramètres de sécurité de votre compte Google.}}"

#. The Excluded apps field once more than three apps are excluded: the names of the first three, then how many more are excluded
#: packages/renderer/routes/settings/workspace-apps.tsx
msgid "{remainingExcludedAppCount, plural, one {{visibleExcludedApps} +# excluded} other {{visibleExcludedApps} +# excluded}}"
msgstr "{remainingExcludedAppCount, plural, one {{visibleExcludedApps} +# exclue} many {{visibleExcludedApps} +# exclues} other {{visibleExcludedApps} +# exclues}}"

