{
  "name": "ggmail",
  "version": "3.65.10",
  "private": true,
  "description": "A desktop app for Gmail with multi-account mail, attachment search, and a mail assistant.",
  "author": "ggmail maintainers",
  "repository": "salexandr0s/ggmail",
  "workspaces": [
    "packages/*"
  ],
  "main": "build-js/app.js",
  "scripts": {
    "build:clean-dist": "bun run scripts/clean-dist.ts",
    "build:js": "bun run i18n:compile && NODE_ENV=production bun run scripts/build.ts",
    "build:linux": "bun run build:js && bun run build:clean-dist && electron-builder --linux",
    "build:mac": "bun run scripts/signing-env.ts mac && bun run build:js && bun run build:clean-dist && electron-builder --mac",
    "build:mac:dmg": "bun run scripts/signing-env.ts mac && bun run build:js && electron-builder --mac dmg --arm64 --publish never --config.forceCodeSigning=true --config.dmg.sign=true --config.dmg.writeUpdateInfo=false --config.dmg.artifactName=ggmail-mac-arm64.dmg",
    "build:mac:local": "bun run scripts/build-mac-local.ts",
    "install:mac:local": "bun run scripts/build-mac-local.ts --install",
    "build:win": "bun run build:js && bun run build:clean-dist && electron-builder --win",
    "dev": "bun run i18n:compile && bun run scripts/build.ts --dev",
    "extensions:download": "bun run scripts/download-extensions.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "i18n:check": "bun run scripts/i18n-check.ts",
    "i18n:compile": "lingui compile && lingui compile --config lingui.pseudo.config.ts",
    "i18n:extract": "lingui extract --clean --workers 1",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix --fix-suggestions --fix-dangerously",
    "postinstall": "electron-builder install-app-deps",
    "test": "bun run i18n:compile && bun test --isolate",
    "test:e2e": "bun run scripts/e2e.ts",
    "types": "bun run i18n:compile && tsc && bun run --filter='*' --elide-lines=0 types",
    "types:ci": "bun run i18n:compile && tsc && bun run --filter='*' types"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/dom": "^0.5.3",
    "@dnd-kit/helpers": "^0.5.3",
    "@dnd-kit/react": "^0.5.3",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/typed-ipc": "^1.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@electron/fuses": "^1.8.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "@lingui/cli": "^6.12.0",
    "@lingui/conf": "^6.12.0",
    "@lingui/core": "^6.12.0",
    "@lingui/format-po": "^6.12.0",
    "@lingui/message-utils": "^6.12.0",
    "@lingui/native-tools": "0.1.6",
    "@lingui/react": "^6.12.0",
    "@lingui/vite-plugin": "^6.12.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.108.1",
    "@tanstack/react-table": "^8.21.3",
    "@total-typescript/tsconfig": "^1.0.4",
    "@types/bun": "^1.4.4",
    "@types/mdast": "^4.0.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-log": "^5.4.4",
    "electron-store": "^10.1.0",
    "electron-updater": "^6.8.11",
    "eslint-plugin-lingui": "^0.16.0",
    "fast-xml-parser": "^5.12.1",
    "fflate": "^0.8.3",
    "frimousse": "^0.3.0",
    "is-online": "^12.0.2",
    "lefthook": "^2.2.2",
    "lucide-react": "^0.475.0",
    "mdast-util-find-and-replace": "^3.0.5",
    "node-api-headers": "^1.9.0",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.94.0",
    "pofile-ts": "^4.0.3",
    "postcss": "^8.5.33",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hotkeys-hook": "^5.4.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "rolldown": "^1.3.3",
    "select-dom": "^9.5.0",
    "serialize-error": "^13.1.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "type-fest": "^5.10.0",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "use-debounce": "^10.1.1",
    "vite": "^8.3.8",
    "wouter": "^3.13.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "overrides": {
    "minimatch@>=7 <11": "11.0.9",
    "postcss-selector-parser": "6.1.5",
    "tinypool": "2.2.0"
  },
  "build": {
    "files": [
      "build-js",
      "static",
      "LOCAL-BUILD.md"
    ],
    "asarUnpack": [
      "build-js/fixture-extension/**",
      "build-js/*.node"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "enableCookieEncryption": true,
      "grantFileProtocolExtraPrivileges": true,
      "resetAdHocDarwinSignature": true
    },
    "appId": "com.github.salexandr0s.ggmail",
    "protocols": {
      "name": "ggmail",
      "schemes": [
        "ggmail",
        "mailto",
        "http",
        "https"
      ]
    },
    "mac": {
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "13.0.0",
      "icon": "build/icon.icns",
      "darkModeSupport": true,
      "target": {
        "target": "default",
        "arch": [
          "x64",
          "arm64"
        ]
      },
      "extendInfo": {
        "CFBundleDisplayName": "ggmail",
        "CFBundleURLSchemes": [
          "ggmail",
          "mailto",
          "http",
          "https"
        ],
        "NSCameraUsageDescription": "ggmail uses your camera for video calls in Google apps such as Meet and Chat.",
        "NSMicrophoneUsageDescription": "ggmail uses your microphone for calls and voice input in Google apps such as Meet and Chat."
      },
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "appImage": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icons/",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "synopsis": "Gmail desktop app",
      "description": "A desktop app for Gmail with multi-account mail, attachment search, and a mail assistant.",
      "category": "Network;Office"
    },
    "win": {
      "verifyUpdateCodeSignature": true,
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "toolsets": {
      "appimage": "1.0.3"
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    },
    "beforePack": "./build/hooks/beforePack.js"
  },
  "patchedDependencies": {
    "conf@14.0.0": "patches/conf@14.0.0.patch",
    "sonner@2.0.7": "patches/sonner@2.0.7.patch",
    "electron-store@10.1.0": "patches/electron-store@10.1.0.patch"
  },
  "productName": "ggmail"
}
